<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/ThemeOverlay.PersonalSamsungGallery"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.fadcam.ui.ZoomableImageView
        android:id="@+id/imageViewerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/image_viewer_title"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/imageViewerTopDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="4dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="4dp"
        android:background="@android:color/transparent"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/imageViewerBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/gallery_viewer_back"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/imageViewerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/image_viewer_title"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageViewerMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/gallery_more"
            android:padding="10dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/imageViewerBottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/gallery_viewer_pill"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <com.fadcam.ui.GalleryMediaStrip android:id="@+id/gallery_media_strip"
            android:layout_width="match_parent" android:layout_height="60dp" android:visibility="gone" />

        <TextView
            android:id="@+id/imageViewerMeta"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/gallery_viewer_favorite" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:padding="12dp" android:src="@drawable/gallery_favorite_outline" android:tint="@android:color/white" android:contentDescription="@string/viewer_add_favorite" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
            <ImageView android:id="@+id/gallery_viewer_edit" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:padding="12dp" android:src="@drawable/gallery_edit_outline" android:tint="@android:color/white" android:contentDescription="@string/viewer_edit" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
<ImageView android:id="@+id/gallery_viewer_share" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:padding="12dp" android:src="@drawable/gallery_share_outline" android:tint="@android:color/white" android:contentDescription="@string/gallery_share" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
            <ImageView android:id="@+id/gallery_viewer_delete" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:padding="12dp" android:src="@drawable/gallery_delete_outline" android:tint="@android:color/white" android:contentDescription="@string/gallery_delete" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
