<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/personal_pro_panel"
 android:layout_width="match_parent" android:layout_height="112dp" android:layout_gravity="bottom" android:layout_marginBottom="200dp"
 android:background="@drawable/personal_pro_adjustment_panel" android:visibility="gone">
 <com.fadcam.ui.PersonalCameraRuler android:id="@+id/personal_pro_slider" android:layout_width="match_parent" android:layout_height="52dp"
 android:layout_gravity="bottom" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" />
 <TextView android:id="@+id/personal_pro_selected_value" android:layout_width="200dp" android:layout_height="48dp"
 android:layout_gravity="top|center_horizontal" android:gravity="center" android:textColor="#FFD400" android:textSize="16sp" android:fontFamily="sec-num" app:fontFamily="sec-num" android:includeFontPadding="false" />
 <com.google.android.material.button.MaterialButton android:id="@+id/personal_pro_auto" style="@style/Widget.MaterialComponents.Button.TextButton"
 android:layout_width="60dp" android:layout_height="48dp" android:layout_gravity="top|start" android:text="@string/personal_pro_auto" android:textColor="#FFD400" android:padding="0dp" android:fontFamily="sec" app:fontFamily="sec" />
 <com.google.android.material.button.MaterialButton android:id="@+id/personal_pro_close" style="@style/Widget.MaterialComponents.Button.TextButton"
 android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:minWidth="0dp" android:padding="0dp"
 android:text="×" android:textSize="24sp" android:textColor="#FFFFFF" android:contentDescription="@string/personal_pro_close" />
</FrameLayout>