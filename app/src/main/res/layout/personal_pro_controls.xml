<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="wrap_content" android:layout_height="30dp" android:fillViewport="false" android:scrollbars="none">
 <LinearLayout android:id="@+id/personal_pro_items" android:layout_width="wrap_content" android:layout_height="match_parent"
  android:orientation="horizontal" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/personal_control_pill">
