<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#101916" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="28dp" android:paddingBottom="32dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/personal_home_title" android:textSize="24sp" android:textStyle="bold" android:textColor="#F0F7F3" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/personal_home_subtitle"
            android:textSize="14sp" android:textColor="#9DB5A7" />
        <LinearLayout android:layout_width="236dp" android:layout_height="236dp"
            android:layout_marginTop="36dp" android:background="@drawable/personal_timer_background"
            android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/personal_home_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="00:00" android:textSize="46sp" android:fontFamily="sans-serif-light"
                android:textColor="#F0F7F3" android:importantForAccessibility="no" />
            <TextView android:id="@+id/personal_home_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/personal_home_syncing"
                android:textSize="14sp" android:textColor="#65D7A0" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/personal_home_record"
            android:layout_width="200dp" android:layout_height="76dp" android:layout_marginTop="28dp"
            android:text="@string/personal_home_start" android:textSize="18sp" android:textStyle="bold"
            android:textColor="#07170F" android:textAllCaps="false" app:backgroundTint="#32B978"
            app:cornerRadius="38dp" app:icon="@drawable/ic_camera" app:iconTint="#07170F"
            app:iconGravity="textStart" app:iconSize="24dp" />
        <TextView android:id="@+id/personal_home_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center" android:text="@string/personal_home_hint"
            android:textSize="13sp" android:lineSpacingExtra="4dp" android:textColor="#9DB5A7" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="36dp" android:orientation="vertical" android:gravity="center_horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/personal_home_camera"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="@string/personal_home_back" android:textColor="#65D7A0" android:textAllCaps="false"
                app:cornerRadius="24dp" app:strokeColor="#355346" />
            <TextView android:id="@+id/personal_home_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center" android:textSize="14sp" android:textColor="#F0F7F3" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center">
                <com.google.android.material.button.MaterialButton android:id="@+id/personal_home_settings"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="48dp"
                    android:text="@string/personal_home_settings" android:textColor="#65D7A0" android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/personal_home_shortcuts"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="48dp"
                    android:text="@string/personal_home_shortcuts" android:textColor="#65D7A0" android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
