<resources>
    <style name="ThemeOverlay.PersonalSamsungVideoPopup" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:fontFamily">sec</item>
        <item name="fontFamily">sec</item>
        <item name="android:textColorPrimary">@color/gallery_video_popup_text</item>
        <item name="android:textColorSecondary">@color/gallery_video_popup_text</item>
        <item name="colorControlNormal">#010102</item>
        <item name="colorAccent">#010102</item>
        <item name="popupMenuStyle">@style/Widget.PersonalSamsungVideoPopup</item>
        <item name="android:popupMenuStyle">@style/Widget.PersonalSamsungVideoPopup</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.PersonalSamsungGalleryMenu</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.PersonalSamsungGalleryMenu</item>
        <item name="listMenuViewStyle">@style/Widget.PersonalSamsungGalleryMenuRow</item>
        <item name="dropdownListPreferredItemHeight">44dp</item>
    </style>
    <style name="Widget.PersonalSamsungVideoPopup" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/gallery_video_popup_surface</item>
        <item name="android:popupElevation">6dp</item>
        <item name="overlapAnchor">false</item>
    </style>
    <style name="TextAppearance.PersonalSamsungGalleryMenu" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:fontFamily">sec</item>
        <item name="fontFamily">sec</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/gallery_video_popup_text</item>
    </style>
    <style name="Widget.PersonalSamsungGalleryMenuRow" parent="">
        <item name="android:itemTextAppearance">@style/TextAppearance.PersonalSamsungGalleryMenu</item>
    </style>
</resources>
